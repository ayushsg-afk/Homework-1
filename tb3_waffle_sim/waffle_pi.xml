<mujoco model="turtlebot3_waffle_pi">
  <compiler angle="degree" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.005" iterations="50" tolerance="1e-10"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="base_link" pos="0 0 0.045">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.12 0.10 0.02" mass="1.5" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      
      <!-- Dedicated site for body axis visualization -->
      <site name="body_frame_site" pos="0 0 0" size="0.01"/>

      <geom name="caster_front" type="sphere" size="0.012" pos="0.09 0 -0.02" mass="0.02" friction="0.005"/>
      <geom name="caster_rear" type="sphere" size="0.012" pos="-0.09 0 -0.02" mass="0.02" friction="0.005"/>

      <body name="left_wheel" pos="0 0.11 -0.005">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.1" armature="0.01"/>
        <geom type="cylinder" size="0.027 0.008" euler="90 0 0" mass="0.1" friction="1.0 0.005 0.0001" solref="0.02 1" rgba="0.9 0.1 0.1 1"/>
      </body>

      <body name="right_wheel" pos="0 -0.11 -0.005">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.1" armature="0.01"/>
        <geom type="cylinder" size="0.027 0.008" euler="90 0 0" mass="0.1" friction="1.0 0.005 0.0001" solref="0.02 1" rgba="0.9 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="3" ctrlrange="-50 50"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="3" ctrlrange="-50 50"/>
  </actuator>
</mujoco>
